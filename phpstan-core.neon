# PN Shop core modules are held to a stricter level than the legacy app/ code.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Every migration that builds the schema: the shop's, the core package's base tables,
    # each core module's own, and the bundled plugins'.
    databaseMigrationsPath:
        - database/migrations
        - packages/pn-shop-core/database/migrations
        - packages/pn-shop-core/src/Acl/database/migrations
        - packages/pn-shop-core/src/Api/database/migrations
        - packages/pn-shop-core/src/Cart/database/migrations
        - packages/pn-shop-core/src/Catalog/database/migrations
        - packages/pn-shop-core/src/Cms/database/migrations
        - packages/pn-shop-core/src/Customer/database/migrations
        - packages/pn-shop-core/src/Extension/database/migrations
        - packages/pn-shop-core/src/Installer/database/migrations
        - packages/pn-shop-core/src/Localization/database/migrations
        - packages/pn-shop-core/src/Media/database/migrations
        - packages/pn-shop-core/src/Payment/database/migrations
        - packages/pn-shop-core/src/Promotion/database/migrations
        - packages/pn-shop-core/src/Returns/database/migrations
        - packages/pn-shop-core/src/Sales/database/migrations
        - packages/pn-shop-core/src/Seo/database/migrations
        - packages/pn-shop-core/src/Settings/database/migrations
        - packages/pn-shop-core/src/Shipping/database/migrations
        - packages/pn-shop-core/src/System/database/migrations
        - packages/pn-shop-core/src/Tax/database/migrations
        - extensions/pnshop/handling-fee/database/migrations
    stubFiles:
        - stubs/phpstan/kalnoy-nestedset.stub
    paths:
        - packages/pn-shop-core/src/
        # Plugins shipped with PN Shop are held to the same standard.
        - extensions/pnshop/
        # Contract test kits in core/*/Testing are analysed through the tests that use them.
        - tests/Feature/Payment/BankTransferContractTest.php
        - tests/Feature/Payment/CashOnDeliveryContractTest.php
        - tests/Feature/Shipping/FlatRateContractTest.php
        - tests/Feature/Returns/ReturnLabelsTest.php
    level: 7
