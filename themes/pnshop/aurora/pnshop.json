{
    "id": "pnshop/aurora",
    "name": "Aurora",
    "description": "A child theme of the default: indigo brand colour, rounder shapes and a different product card. Shows how themes override files.",
    "version": "1.0.2",
    "type": "theme",
    "parent": "pnshop/default",
    "requires": { "pnshop": "^1.11" },
    "settings": [
        {
            "key": "primary",
            "type": "color",
            "label": "Brand colour",
            "default": "#4f46e5",
            "css_var": "--primary",
            "contrast_var": "--primary-foreground"
        },
        {
            "key": "radius",
            "type": "select",
            "label": "Corners",
            "default": "1rem",
            "css_var": "--radius",
            "options": { "0.375rem": "Slightly rounded", "0.625rem": "Rounded", "1rem": "Very rounded" }
        }
    ],
    "author": "PN Scripts"
}
