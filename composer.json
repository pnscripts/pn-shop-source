{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pnscripts/pn-shop",
    "type": "project",
    "description": "PN Scripts Shop: an open-source Laravel CMS and e-commerce platform with a React/Inertia storefront.",
    "keywords": [
        "laravel",
        "react",
        "inertia",
        "ecommerce",
        "shop",
        "cms",
        "pn-shop"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "pnscripts/pn-shop-core": "^1.1@dev",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "dedoc/scramble": "^0.13",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/telescope": "^5.7",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.3"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/pn-shop-core",
            "options": {
                "symlink": true,
                "versions": {
                    "pnscripts/pn-shop-core": "1.1.0-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php -r \"echo PHP_EOL, 'Next: php artisan pnshop:install, or open /install in the browser.', PHP_EOL;\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ],
        "api-docs": [
            "@php artisan scramble:export --path=docs/api/store-v1.json",
            "@php artisan scramble:export --api=admin --path=docs/api/admin-v1.json"
        ]
    },
    "extra": {
        "pnshop": {
            "monorepo": true
        },
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
