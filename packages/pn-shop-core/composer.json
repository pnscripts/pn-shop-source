{
    "name": "pnscripts/pn-shop-core",
    "type": "library",
    "description": "The PN Scripts Shop platform core: catalog, cart, checkout, orders, payments, shipping, tax, CMS, SEO, promotions, returns, plugins, themes, APIs and the installer.",
    "keywords": [
        "pn-shop",
        "laravel",
        "e-commerce",
        "cms",
        "shop"
    ],
    "license": "MIT",
    "homepage": "https://github.com/pnscripts/pn-shop-source",
    "authors": [
        {
            "name": "Petar Nikolov",
            "homepage": "https://github.com/petar-v-nikolov"
        }
    ],
    "require": {
        "php": "^8.4",
        "brick/money": "^0.15.2",
        "composer/semver": "^3.4",
        "filament/filament": "^5.9",
        "inertiajs/inertia-laravel": "^3.4",
        "intervention/image": "^4.3",
        "kalnoy/nestedset": "^7.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3",
        "symfony/html-sanitizer": "^8.1",
        "tightenco/ziggy": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "PnShop\\": "src/",
            "PnShop\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PnShop\\Foundation\\PnShopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
